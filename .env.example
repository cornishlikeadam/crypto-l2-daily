# FREE route (default): session cookies from a logged-in X account (x.com in your browser).
# Use a secondary X account if you can: automated searching is against X's terms and can get an account limited.
X_AUTH_TOKEN=
X_CT0=

# PAID route (optional): X API v2 bearer token. Ignored when the cookies above are set.
X_BEARER_TOKEN=
# Posts per query (10-100).
X_MAX_RESULTS=25
