<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ⏰ Crypto L2 Daily: run scripts/daily.sh every day at 18:00. If the Mac is asleep then, launchd runs it at the
     next wake. Install: cp to ~/Library/LaunchAgents/ and run
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.not2l8.l2daily.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.not2l8.l2daily</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/kjcornish/crypto-l2-daily/scripts/daily.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/kjcornish/crypto-l2-daily/logs/daily.log</string>
  <key>StandardErrorPath</key><string>/Users/kjcornish/crypto-l2-daily/logs/daily.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
